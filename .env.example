APP_NAME=Winchestack
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# Admin único do sistema (lido pelo DatabaseSeeder). Defina antes de `db:seed`.
# Se ADMIN_PASSWORD ficar vazio, uma senha aleatória é gerada e impressa 1x.
ADMIN_NAME="Administrador"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# ADMIN_EMAIL=

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=7
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Banco: PostgreSQL (Docker, porta 5433 p/ não bater com o watchtower) ──
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=winchestack
DB_USERNAME=winchestack
DB_PASSWORD=winchestack

# ── Sessão / cache / fila: Redis (Docker, porta 6380) ────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────────────────────
# Integrações de monitoramento
# ─────────────────────────────────────────────────────────────────────
# Espectadores das câmeras: endpoint /health do relay do watchtower.
# Em produção o relay costuma escutar em 127.0.0.1:9000.
WATCHTOWER_RELAY_HEALTH_URL=http://127.0.0.1:9000/health
WATCHTOWER_RELAY_VIEWERS_URL=http://127.0.0.1:9000/viewers
WATCHTOWER_CAMERAS_URL=http://127.0.0.1:8000/internal/cameras

# Roteador OpenWrt (LAN).
OPENWRT_HOST=127.0.0.1
OPENWRT_SSH_USER=root
OPENWRT_SSH_PORT=22
OPENWRT_SSH_KEY=
